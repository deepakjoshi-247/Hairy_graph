# HairyGraph Configuration Example

# Optional authentication key. When set, all endpoints except /health require X-API-Key header.
MEMORY_API_KEY=change-me-to-a-strong-key

# Path to the SQLite database file (defaults to hairy_graph.db in the working directory)
MEMORY_DB_PATH=hairy_graph.db

# Embedding model identifier for dense representation / hybrid retrieval extensions
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
